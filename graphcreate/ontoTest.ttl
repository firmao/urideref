@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/ontology#> .

ex:ResearchSoftware rdf:type owl:Class ;
    rdfs:label "Research Software" .

ex:Dataset rdf:type owl:Class ;
    rdfs:label "Dataset" .

ex:SoftwareSourceCode rdf:type owl:Class ;
    rdfs:label "Software Source Code" ;
    rdfs:subClassOf ex:ResearchSoftware .

ex:AcademicArticle rdf:type owl:Class ;
    rdfs:label "Academic Article" ;
    rdfs:subClassOf ex:ResearchPaper .

ex:ResearchPaper rdf:type owl:Class ;
    rdfs:label "Research Paper" .

ex:Author rdf:type owl:Class ;
    rdfs:label "Author" .

ex:Project rdf:type owl:Class ;
    rdfs:label "Project" .

ex:Researcher rdf:type owl:Class ;
    rdfs:label "Researcher" .

ex:DOI rdf:type owl:Class ;
    rdfs:label "Digital Object Identifier (DOI)" .

ex:ORCID rdf:type owl:Class ;
    rdfs:label "ORCID" .


ex:hasDOI rdf:type owl:ObjectProperty ;
    rdfs:label "has DOI" ;
    rdfs:domain rdfs:Resource ;
    rdfs:range ex:DOI .

ex:usesDataset rdf:type owl:ObjectProperty ;
    rdfs:label "uses dataset" ;
    rdfs:domain ex:SoftwareSourceCode ;
    rdfs:range ex:Dataset .

ex:producedByAcademicArticle rdf:type owl:ObjectProperty ;
    rdfs:label "produced by academic article" ;
    rdfs:domain ex:SoftwareSourceCode ;
    rdfs:range ex:AcademicArticle .

ex:hasAuthor rdf:type owl:ObjectProperty ;
    rdfs:label "has author" ;
    rdfs:domain ex:AcademicArticle ;
    rdfs:range ex:Author .

ex:representedByORCID rdf:type owl:ObjectProperty ;
    rdfs:label "represented by ORCID" ;
    rdfs:domain ex:Author ;
    rdfs:range ex:ORCID .

ex:producedByProject rdf:type owl:ObjectProperty ;
    rdfs:label "produced by project" ;
    rdfs:domain ex:AcademicArticle ;
    rdfs:range ex:Project .

ex:writesResearchPaper rdf:type owl:ObjectProperty ;
    rdfs:label "writes research paper" ;
    rdfs:domain ex:Researcher ;
    rdfs:range ex:ResearchPaper .

ex:hasORCID rdf:type owl:ObjectProperty ;
    rdfs:label "has ORCID" ;
    rdfs:domain ex:Researcher ;
    rdfs:range ex:ORCID .


ex:ResearchSoftware rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ex:hasDOI ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass ex:DOI
] .

ex:Dataset rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ex:hasDOI ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass ex:DOI
] .

ex:ResearchPaper rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty ex:hasDOI ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass ex:DOI
] .
